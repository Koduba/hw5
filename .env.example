# Copy to .env and fill in. Never commit .env.
PORTKEY_API_KEY=
# HW5 allows only gpt-6-luna; the backend refuses any other value.
OPENAI_MODEL=gpt-6-luna
# Optional loop guards
MAX_DELEGATION_DEPTH=3
AGENT_REQUEST_LIMIT=60
MODEL_TIMEOUT=90
# Dashboard origins allowed by CORS (comma-separated)
DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
